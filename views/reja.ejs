<!DOCTYPE html>
<html lang="en">
<head>
    
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>REJA</title>
        <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
        crossorigin="anonymous"
        />
        <link href="https://fonts.googleapis.com/css?family=Roboto" rel="stylesheet">

        <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

   <!-- Custom CSS -->
   <link rel="stylesheet" href="/style.css" />

    
</head>
<body style="background-color: #b8bbd1">
    <div class="container">

      <div class="main-wrapper">
        <div class="text-end">
      👋 Welcome, <strong><%= session.user.username %></strong> |
      <a href="/logout" class="btn btn-outline-danger btn-sm">Logout</a>
    </div>

        <h1 class="display-4 text-center py-1">REJA VA MAQSADLAR</h1>

        <!-- Form -->
        <div class="jumbotron p-3 shadow-sm">
            <form id="create-form" action="/create-item" method="POST">
              <div class="d-flex align-items-center">
                <input
                  id="create-field"
                  name="reja"
                  autofocus
                  autocomplete="off"
                  class="form-control mr-3"
                  type="text"
                  style="flex: 1"
                />
                <button class="btn btn-primary" style="border-radius: 20px">
                  Yangi Reja Qoshish
                </button>
              </div>
            </form>
          </div>

          <!-- Item List -->
          <ul id="item-list" class="list-group pb-5">
            <% items.map(function(item) { %>
            <li
              class="list-group-item list-group-item-info d-flex align-items-center justify-content-between"
            >
                <span class="item-text"><%=item.reja%></span>
                <div>
                  <button 
                    data-id="<%=item._id%>"
                    class="edit-me btn btn-secondary btn-sm mr-1">
                     Ozgartirish
                  </button>

                  <!-- Delete All Button -->
                  <button 
                    data-id="<%=item._id%>" 
                    class="delete-me btn btn-danger btn-sm"
                  >
                    Ochirish
                </button>
              </div>
            </li>
            <% }) %>
          </ul>

           <!-- Delete All Button -->
          <button id="clean-all" class="btn btn-danger" style="border-radius: 20px;">
            Hamma Rejalarni O'chirish
          </button>
      </div>

      <!-- Footer -->
    <footer class="mt-5">
      &copy; <%= new Date().getFullYear() %> Daily plan App by Abror Fayzullaev
    </footer>
  </div>

      <!-- Scripts -->
      <script src="https://unpkg.com/axios/dist/axios.min.js"></script>
      <script src="/browser.js"></script>
</body>
</html>